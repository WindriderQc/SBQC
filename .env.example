# SBQC Server Environment Configuration
# This file contains example environment variables
# Copy this file to .env and fill in your actual values

# Server Configuration
NODE_ENV=development
PORT=3001
SBQC_PUBLIC_PORT=3001

# Frontend URL (for CORS)
FRONT_URL=http://localhost:3000

# MongoDB Connection
# CRITICAL: Must point to the SAME MongoDB server as DataAPI for session sharing
# Format: mongodb://username:password@host:port/
MONGO_CLOUD=mongodb://localhost:27017/
ALLOW_DB_BOOTSTRAP_FAILURE=true

# Public AgentX MongoDB Cloud target.
# This database contains only pre-filtered public documents pushed from AgentX.
MONGO_PUBLIC_URI=
MONGO_PUBLIC_DB=agentx_public

# Folder where AgentX public JSON/images are mounted on the cloud server.
PUBLIC_ASSET_ROOT=/srv/public-agentx

# Session Configuration
# CRITICAL FOR AUTHENTICATION:
# SESS_SECRET MUST match DataAPI's SESSION_SECRET exactly
# Both apps must share the same secret for session sharing to work
SESS_SECRET=your_session_secret_here_must_match_dataapi
SESS_NAME=data-api.sid
TOKEN_SECRET=replace_with_jwt_secret_for_mqtt_tokens

# DataAPI Configuration
# Base URL for DataAPI (used for external API calls)
DATA_API_URL=https://data.specialblend.ca
DATA_API_PORT=

# MQTT Configuration (if using IoT features)
MQTT_ENABLED=true
MQTT_BROKER_URL=mqtt://specialblend.ca
MQTT_SERVER_URL=mqtt://mqtt.specialblend.ca
MQTT_SERVER_WS=wss://specialblend.ca/mqtt
MQTT_TOPICS=esp32,esp32/#,sbqc/iss
USER=
PASS=
